generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  role              String             @default("viewer") // admin, manager, viewer
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  conversations     Conversation[]
  auditLogs         AuditLog[]
  notificationReads NotificationRead[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Developer {
  id          String        @id @default(cuid())
  name        String
  email       String        @unique
  role        String
  seniority   String // junior, mid, senior, lead
  avatarUrl   String?
  benchSince  DateTime?
  skills      Skill[]
  assignments Assignment[]
  contracts   Contract[]
  performance Performance[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([name])
  @@index([seniority])
  @@index([benchSince])
}

model Skill {
  id          String    @id @default(cuid())
  name        String // React, Node.js, Flutter, etc.
  level       String // beginner, intermediate, advanced, expert
  yearsExp    Int
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  developerId String

  @@unique([developerId, name])
  @@index([name])
}

model Client {
  id          String       @id @default(cuid())
  name        String       @unique
  industry    String // fintech, retail, real-estate, banking, etc.
  logoUrl     String?
  contacts    Contact[]
  assignments Assignment[]
  contracts   Contract[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([industry])
}

model Contact {
  id       String  @id @default(cuid())
  name     String
  role     String
  email    String  @unique
  phone    String?
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@index([clientId])
}

model Assignment {
  id            String    @id @default(cuid())
  projectName   String
  status        String    @default("active") // active, ending, transition, completed
  startDate     DateTime
  endDate       DateTime?
  jiraBoardUrl  String?
  githubRepoUrl String?
  developer     Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  developerId   String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([developerId, status])
  @@index([clientId, status])
  @@index([status, endDate])
}

model Contract {
  id          String    @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  billingRate Decimal // monthly rate
  status      String    @default("active") // active, renewing, expired
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  developerId String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([developerId, status])
  @@index([clientId, status])
  @@index([status, endDate])
}

model Performance {
  id           String    @id @default(cuid())
  period       String // "2026-Q1", "2026-03"
  velocity     Float // story points per sprint
  prMergeTime  Float // avg days to merge PR
  codeQuality  Float // 0-100 score
  clientRating Float? // 1-5
  notes        String?
  developer    Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  developerId  String
  createdAt    DateTime  @default(now())

  @@unique([developerId, period])
  @@index([period])
  @@index([createdAt])
}

model Conversation {
  id            String    @id @default(cuid())
  title         String?
  // Session user IDs and hashed API-key identities both use this scope.
  accessSubject String?
  messages      Message[]
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([updatedAt])
  @@index([accessSubject])
}

model Message {
  id             String       @id @default(cuid())
  role           String // user, assistant, tool
  content        String
  toolCalls      String? // JSON string of tool calls
  toolCallId     String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([role])
}

model ChatUsage {
  id        String   @id @default(cuid())
  subject   String // user:<id> or api-key
  day       String // UTC day, YYYY-MM-DD
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subject, day])
  @@index([day])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorType   String // user, api-key
  actorName   String
  actorKey    String?
  action      String // create, update, delete
  entityType  String // developer, client, contract, assignment, performance, user
  entityId    String
  beforeState String?
  afterState  String?
  requestId   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

model StaffingAlert {
  id            String          @id @default(cuid())
  fingerprint   String          @unique
  type          String // bench, contract, performance
  severity      String // high, medium, low
  status        String          @default("open") // open, resolved
  entityType    String // developer, contract
  entityId      String
  message       String
  data          String          @default("{}")
  firstSeenAt   DateTime        @default(now())
  lastSeenAt    DateTime        @default(now())
  resolvedAt    DateTime?
  lastEventAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deliveries    AlertDelivery[]
  notifications Notification[]

  @@index([status, lastSeenAt])
  @@index([type, severity])
  @@index([entityType, entityId])
}

model AlertDelivery {
  id             String        @id @default(cuid())
  alertId        String
  event          String // opened, updated, reopened, resolved
  snapshot       String // JSON snapshot of alert state at event time
  status         String        @default("pending") // pending, processing, succeeded, failed
  destination    String?
  attemptCount   Int           @default(0)
  nextAttemptAt  DateTime      @default(now())
  lastError      String?
  responseStatus Int?
  deliveredAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  alert          StaffingAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  notification   Notification?

  @@index([alertId, createdAt])
  @@index([status, nextAttemptAt])
}

model Notification {
  id         String             @id @default(cuid())
  alertId    String
  deliveryId String             @unique
  event      String
  severity   String
  title      String
  message    String
  createdAt  DateTime           @default(now())
  alert      StaffingAlert      @relation(fields: [alertId], references: [id], onDelete: Cascade)
  delivery   AlertDelivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  reads      NotificationRead[]

  @@index([createdAt])
  @@index([severity, createdAt])
}

model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
}

model WorkerLease {
  name               String    @id
  ownerId            String?
  expiresAt          DateTime
  runCount           Int       @default(0)
  lastRunAt          DateTime?
  lastSuccessAt      DateTime?
  lastDurationMs     Int?
  lastScanDurationMs Int?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([expiresAt])
}
