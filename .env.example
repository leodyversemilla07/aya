# Shared root environment for the API, web application, authentication, Prisma, and tests.
DATABASE_URL="file:./dev.db"
NODE_ENV="development"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated emails that may self-register as administrators in production.
ADMIN_EMAILS=""

# LLM
LLM_PROVIDER="opencode-zen"
LLM_API_KEY="your-api-key"
# Optional provider-specific alternatives:
# OPENAI_API_KEY=""
# OPENROUTER_API_KEY=""
# OPENCODE_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
LLM_BASE_URL="https://opencode.ai/zen/v1"
LLM_MODEL="minimax-m2.5-free"
LLM_TIMEOUT_MS="60000"
LLM_MAX_RETRIES="2"
LLM_MAX_TOKENS="4096"
LLM_CONTEXT_WINDOW="128000"
AGENT_TIMEOUT_MS="180000"

# API
API_PORT="3001"
API_KEY="change-me-to-a-long-random-string"
CORS_ORIGINS="http://localhost:3000"
# Set to "true" when the API runs behind a trusted reverse proxy.
TRUST_PROXY="false"
# Maximum chat requests per user (or API key) per UTC day. Set to 0 to disable.
CHAT_DAILY_QUOTA="200"

# Background staffing alert worker
ALERT_SCAN_INTERVAL_MS="60000"
ALERT_LEASE_SECONDS="60"
# Configure both values to deliver alert lifecycle events to a signed webhook.
ALERT_WEBHOOK_URL=""
ALERT_WEBHOOK_SECRET=""
ALERT_WEBHOOK_TIMEOUT_MS="10000"
ALERT_WEBHOOK_MAX_ATTEMPTS="5"

# Optional Prometheus scrape token. Leave empty to disable GET /metrics.
METRICS_TOKEN=""

# Browser API origin
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Seed controls
SEED_FORCE="false"
SEED_RESET_CONVERSATIONS="false"
# Test-only: delete auth users, sessions, and audit history while seeding.
SEED_RESET_USERS="false"
