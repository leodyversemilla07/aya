# Server-only values used by the Next.js API proxy. Never prefix these with
# NEXT_PUBLIC_, otherwise the API key would be exposed to the browser.
AYA_API_URL="http://localhost:3001"
AYA_API_KEY="change-me-to-the-same-value-as-apps/api/.env"

# Optional comma-separated origins allowed to make state-changing proxy calls.
# The current request origin is allowed automatically; configure this when a
# reverse proxy or custom deployment origin differs from the browser origin.
AYA_ALLOWED_ORIGINS=""
