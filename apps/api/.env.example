# SQLite database. Relative paths are resolved from packages/db/prisma.
DATABASE_URL="file:./dev.db"

# LLM provider: openai, openrouter, or opencode-zen (default)
LLM_PROVIDER="opencode-zen"
LLM_API_KEY="your-api-key"
LLM_BASE_URL="https://opencode.ai/zen/v1"
LLM_MODEL="minimax-m2.5-free"
LLM_TIMEOUT_MS="60000"
LLM_MAX_RETRIES="2"
LLM_MAX_TOKENS="4096"

# Total deadline for one agent turn, including tool calls and provider retries.
AGENT_TIMEOUT_MS="180000"

# API server
API_PORT="3001"
# Required in every environment. The Next.js proxy reads the same value from AYA_API_KEY.
API_KEY="change-me-to-a-long-random-string"
CORS_ORIGINS="http://localhost:3000"
