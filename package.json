{
  "name": "aya",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "bun run --cwd apps/api test:e2e",
    "db:generate": "bun run --cwd packages/db generate",
    "db:push": "bun run --cwd packages/db push",
    "db:migrate": "bun run --cwd packages/db migrate:dev",
    "db:migrate:deploy": "bun run --cwd packages/db migrate:deploy",
    "db:seed": "bun run --cwd packages/db seed",
    "db:studio": "bun run --cwd packages/db studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["apps/*", "packages/*"]
}
