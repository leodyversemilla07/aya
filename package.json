{
  "name": "aya",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "audit": "pnpm audit --prod",
    "audit:all": "pnpm audit",
    "dev": "turbo dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "DATABASE_URL=${DATABASE_URL:-file:./test-e2e.db} pnpm --filter @workspace/db run migrate:deploy && pnpm --filter @aya/api run test:e2e",
    "test:e2e:web": "NEXT_PUBLIC_API_URL=http://localhost:3001 pnpm run build && pnpm --filter web run test:e2e",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:migrate": "pnpm --filter @workspace/db run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @workspace/db run migrate:deploy",
    "db:drift": "pnpm --filter @workspace/db run migrate:drift",
    "db:postgres:sync": "pnpm --filter @workspace/db run schema:postgres",
    "db:postgres:check": "pnpm run db:postgres:sync && git diff --exit-code -- packages/db/prisma/schema.postgresql.prisma",
    "db:seed": "pnpm --filter @workspace/db run seed",
    "db:studio": "pnpm --filter @workspace/db run studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.15.0"
  }
}
